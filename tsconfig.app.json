{
  "compilerOptions": {
    "composite": true,                            /* Required for project references */
    "tsBuildInfoFile": "./node_modules/.bin/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    
    /* REMOVE "noEmit": true and use this instead to satisfy Jest/References */
    "emitDeclarationOnly": true,                  

    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Map Jest runner globals safely */
    "types": ["jest", "@testing-library/jest-dom", "vite/client"]
  },
  "include": ["src"]
}